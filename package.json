{
  "name": "@zopkit/platform-sdk",
  "version": "0.3.0",
  "description": "Shared integration SDK for the Zopkit Business Suite — event bus, auth, outbox, temporal, idempotency",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./temporal/workflows": {
      "types": "./dist/temporal/workflows/index.d.ts",
      "default": "./dist/temporal/workflows/index.js"
    },
    "./temporal/worker": {
      "types": "./dist/temporal/worker.d.ts",
      "default": "./dist/temporal/worker.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1024.0",
    "@aws-sdk/client-sqs": "^3.1024.0",
    "@temporalio/activity": "^1.11.7",
    "@temporalio/client": "^1.11.7",
    "@temporalio/worker": "^1.11.7",
    "@temporalio/workflow": "^1.11.7",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.1.3",
    "lru-cache": "^11.3.6",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "fastify": "^5.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "protobufjs"
    ]
  },
  "license": "UNLICENSED"
}
